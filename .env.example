# --- Assignment 2: Backend ---
DATABASE_URL=postgresql+psycopg://moksha:moksha@localhost:5432/moksha
# Optional. Overrides DATABASE_URL for Alembic only. On a managed Postgres, point the app at the
# pooled endpoint and migrations at the direct one — a transaction pooler hands each transaction a
# different backend session, which is hostile to multi-statement DDL.
MIGRATION_DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

