# --- Demo sign-in (optional) ---
# Set this and POST /api/v1/auth/demo accepts it as a password for the seeded demo admin
# and customer accounts. Unset, that endpoint returns 404 and does not exist.
# It is an authentication shortcut, not an authorization bypass: it issues the same JWT as
# Google sign-in for a real user row, and every server-side check still applies. It exists
# because the Google consent screen is in Testing mode, so a reviewer cannot otherwise sign
# in at all. Leave it unset for anything that is not a demo.
DEMO_LOGIN_PASSWORD=choose-a-long-random-string

# --- Assignment 2: Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
