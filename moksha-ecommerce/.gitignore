# Private local Postgres cluster (see scripts/pg-local.ps1).
# A developer data directory, never a deliverable — recreate it with `pg-local.ps1 init`.
.pgdata/

# Local env override for the private cluster's port.
backend/.env.local

# Editable-install metadata, regenerated by `pip install -e .`
backend/*.egg-info/

# Vite local env (contains the Google client id for local dev)
frontend/.env.local
frontend/dist/
